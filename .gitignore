# Dependency resolutions are versioned so Flutter 3.47.1 resolves the same
# package graph locally and in CI.

# Environment
.env
*.env

# Test/build caches
coverage/
.test_runner/

# Claude Code
# CLAUDE.md se versiona: es la guía de arquitectura para agentes y para el equipo.
# Solo se ignora la configuración local por máquina.
.claude/
**/.claude/

# Old app directory
app_old/

# PDF.js autoalojado y parchado: build/ lo excluye la regla general, pero
# platform_security_config_test lo exige y SHA256SUMS lo verifica.
!theos_pos/web/pdfjs/*/build/
