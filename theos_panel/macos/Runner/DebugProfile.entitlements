<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 12-sep-2026: sandbox restored. The signing team (W8V3ANSPKT) is
	     active and configured in project.pbxproj (DEVELOPMENT_TEAM), and
	     `keychain-access-groups` below is exactly the entitlement `secd`
	     was refusing without it — see the history this replaces, kept in
	     git blame: 2026-09-11 measured that App Sandbox requires one of
	     com.apple.application-identifier, com.apple.security.application-groups
	     or keychain-access-groups for ANY Keychain Services call from an
	     ad-hoc signed binary (-34018, "a required entitlement isn't
	     present"), and that flutter_secure_storage's macOS
	     `usesDataProtectionKeychain` flag makes no difference either way.
	     Debug now matches Release again: same team, same keychain-access
	     group, same sandbox. If the keychain still fails after this, that
	     is a NEW finding, not a repeat of the old one — see C01 §4. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.tecnosmart.theosPanel</string>
	</array>
</dict>
</plist>
